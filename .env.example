# Conexión a Postgres (Neon, Supabase, Vercel Postgres...)
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require
# Texto largo y secreto para firmar las sesiones (mínimo 32 caracteres)
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Opcional: clave de https://serper.dev para ver resultados de proveedores dentro de la app
SERPER_API_KEY=

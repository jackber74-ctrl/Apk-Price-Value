# Conexión a Postgres (Neon, Supabase, Vercel Postgres...)
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require
# Texto largo y secreto para firmar las sesiones (mínimo 32 caracteres)
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Opcional: clave de https://serper.dev para ver resultados de proveedores dentro de la app
SERPER_API_KEY=

# Dirección pública de la app, sin barra final (ej.: https://apk-price-value.vercel.app).
# Debe coincidir con la que registras en Google, Facebook y TikTok.
APP_URL=

# Inicio de sesión social. Cada botón aparece solo si están sus dos claves.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Datos del responsable que aparecen en los Términos y la Política de privacidad
LEGAL_NAME=
LEGAL_ID=
LEGAL_EMAIL=
LEGAL_ADDRESS=
LEGAL_CITY=Medellín, Colombia
LEGAL_PHONE=

# Opcional: enlaces a instaladores ya generados (se muestran en /descargar)
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_WINDOWS_URL=

# Cobros con Mercado Pago (Credenciales de producción de tu aplicación en mercadopago.com.co/developers)
MP_ACCESS_TOKEN=
# Clave secreta del webhook (opcional pero recomendada) y moneda en la que se cobra
MP_WEBHOOK_SECRET=
MP_CURRENCY=COP
# Cuántos pesos vale 1 dólar al cobrar (los precios de los planes están en USD)
MP_USD_RATE=4000

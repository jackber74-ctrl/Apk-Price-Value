# Conexión a Postgres (Neon, Supabase, Vercel Postgres...)
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require
# Texto largo y secreto para firmar las sesiones (mínimo 32 caracteres)
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Opcional: clave de https://serper.dev para ver resultados de proveedores dentro de la app
SERPER_API_KEY=

# Correos (recuperar contraseña) con https://resend.com. Sin la clave, en producción no se envían.
RESEND_API_KEY=
# Remitente. Debe ser de un dominio verificado en Resend (ej.: Apk Price Value <no-responder@tudominio.com>).
MAIL_FROM=

# Dirección pública de la app, sin barra final (ej.: https://apk-price-value.vercel.app).
# Debe coincidir con la que registras en Google, Facebook y TikTok.
APP_URL=

# Inicio de sesión social. Cada botón aparece solo si están sus dos claves.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Datos del responsable que aparecen en los Términos y la Política de privacidad
LEGAL_NAME=
LEGAL_ID=
LEGAL_EMAIL=
LEGAL_ADDRESS=
LEGAL_CITY=Medellín, Colombia
LEGAL_PHONE=

# Opcional: enlaces a instaladores ya generados (se muestran en /descargar)
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_WINDOWS_URL=

# Cobros con Mercado Pago (Credenciales de producción de tu aplicación en mercadopago.com.co/developers)
MP_ACCESS_TOKEN=
# Clave secreta del webhook (opcional pero recomendada) y moneda en la que se cobra
MP_WEBHOOK_SECRET=
MP_CURRENCY=COP

# Cobros con PayU Latam (tiene prioridad sobre Mercado Pago si está configurado).
# En el panel de PayU: Configuración → Configuración técnica.
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_API_KEY=
# 1 = modo de pruebas (usa la cuenta sandbox pública de PayU si faltan las claves). Quítalo en producción.
PAYU_TEST=
# Moneda de cobro (sirve para cualquier pasarela). La tasa es fija: USD_COP = 3700 en src/lib/plans.ts.
PAY_CURRENCY=COP

# Cobro automático (PayU Pagos recurrentes). PayU debe habilitar el producto en tu cuenta.
PAYU_RECURRING=
PAYU_API_LOGIN=
# Clave para la revisión diaria de cobros (Vercel Cron la envía sola si existe en el proyecto)
CRON_SECRET=

# Rapyd (tiene prioridad sobre PayU y Mercado Pago). Panel de Rapyd → Developers → Credentials.
RAPYD_ACCESS_KEY=
RAPYD_SECRET_KEY=
# 1 = claves de prueba (sandbox). Quítalo con las claves de producción.
RAPYD_SANDBOX=
# País de los pagos (por defecto CO). RAPYD_RECURRING=0 apaga el cobro automático.
RAPYD_COUNTRY=
RAPYD_RECURRING=
